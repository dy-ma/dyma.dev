---
import NewspaperStory from '@/components/NewspaperStory.astro';
import { VisitorCounter } from '@/components/VisitorCounter';
import SiteLayout from '@/layouts/SiteLayout.astro';
import { getHomeArticles } from '@/lib/articles';

export const prerender = true;

const homeArticles = await getHomeArticles();
const introduction =
  'ey, I’m Dylan, a software engineer working on infrastructure at Aina. I work on software systems and the tools used to run them. Most of my work is concerned with how services are deployed, observed, and kept working as they change. This page is a record of some of that work. The notes below offer brief accounts of Drop, Fabric, and Redthing. I design and operate infrastructure, I care about making systems understandable, and I am usually working somewhere between the application and the machines underneath it.';
---

<SiteLayout>
  <main>
    <article class="relative mx-auto min-h-svh w-[min(calc(100%_-_48px),1040px)] pt-[clamp(44px,7vw,88px)] pb-[clamp(46px,6vw,78px)] max-[760px]:w-[min(calc(100%_-_28px),100%)] max-[760px]:pt-10">
      <VisitorCounter client:load />

      <figure class="mx-auto mt-[clamp(48px,7vw,78px)] w-[min(92%,820px)] max-[760px]:w-full">
        <img
          class="block h-auto w-full"
          src="/images/pig-field.png"
          width="900"
          height="600"
          alt="A pig sitting in an open field, facing away toward the horizon."
          loading="eager"
          fetchpriority="high"
        />
        <figcaption class="mt-2 text-center text-xs italic">Fig. 1</figcaption>
      </figure>

      <div id="about">
        <p class="mt-[clamp(54px,8vw,92px)] columns-2 gap-[clamp(24px,4vw,48px)] text-justify text-[22px] leading-[1.34] [column-fill:balance] [text-justify:inter-word] max-[620px]:columns-1 max-[620px]:text-left max-[620px]:text-[1.16rem] max-[620px]:leading-[1.48]">
          <span class="float-left mt-[0.035em] mr-[0.08em] text-[4.45em] leading-[0.7]">H</span>{introduction}
        </p>
      </div>
    </article>

    <div
      class="mx-auto mt-[clamp(0.9rem,2vw,1.8rem)] mb-[clamp(1rem,2.2vw,2rem)] w-[min(calc(100%_-_48px),1040px)] border-t border-rule max-[760px]:w-[min(calc(100%_-_28px),100%)]"
      aria-hidden="true"
    ></div>

    <section
      id="work"
      class="relative mx-auto w-[min(calc(100%_-_48px),1040px)] pt-[clamp(16px,2.9vw,30px)] max-[760px]:w-[min(calc(100%_-_28px),100%)]"
      aria-labelledby="work-title"
    >
      <header class="py-[clamp(12px,1.8vw,20px)] pb-[clamp(10px,1.2vw,16px)] text-center max-[540px]:pt-4 max-[540px]:pb-[13px]">
        <h2
          id="work-title"
          class="mx-auto max-w-[14ch] text-[clamp(3.2rem,7vw,6.4rem)] leading-[0.82] font-light tracking-[-0.055em] max-[540px]:text-[clamp(2.85rem,15vw,4.25rem)] max-[540px]:font-normal"
        >
          What I’ve been up to
        </h2>
        <div class="mt-[0.9rem] flex justify-center gap-[1.1rem] text-[1.02rem] max-[540px]:flex-col max-[540px]:items-center max-[540px]:gap-[0.35rem]">
          <a
            class="text-[1.16rem] italic underline-offset-[0.17em] focus-visible:outline-2 focus-visible:outline-offset-[5px] focus-visible:outline-ink"
            href="/articles"
          >
            All articles →
          </a>
        </div>
      </header>
      <div class="grid grid-cols-[minmax(0,2fr)_minmax(210px,1fr)] items-stretch border-y-4 border-double border-ink max-[540px]:block">
        {
          homeArticles.map((article, index) => (
            <NewspaperStory
              article={article}
              index={index}
              total={homeArticles.length}
              returnTo="/#work"
              returnLabel="← Back"
            />
          ))
        }
      </div>
    </section>
  </main>
</SiteLayout>
