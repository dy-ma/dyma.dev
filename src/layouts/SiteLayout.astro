---
import SiteFooter from '@/components/SiteFooter.astro';
import '@/styles.css';

interface Props {
  title?: string;
  description?: string;
  articlePage?: boolean;
  noIndex?: boolean;
}

const {
  title = 'Dylan Mou Ang — Software Engineer',
  description =
    'Dylan Mou Ang is a software engineer working on infrastructure at Aina.',
  articlePage = false,
  noIndex = false,
} = Astro.props;
---

<!doctype html>
<html
  lang="en"
  class="min-h-full scroll-smooth bg-paper [color-scheme:only_light] motion-reduce:scroll-auto"
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <meta name="color-scheme" content="light" />
    {noIndex && <meta name="robots" content="noindex, nofollow" />}
    <link
      rel="preload"
      href="/fonts/cormorant-garamond-roman.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/cormorant-garamond-italic.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body class="min-h-full bg-paper font-serif text-[20px] leading-[1.45] text-ink [text-rendering:optimizeLegibility] selection:bg-ink selection:text-paper">
    <slot />
    <SiteFooter articlePage={articlePage} />
  </body>
</html>
